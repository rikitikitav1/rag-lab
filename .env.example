# Copy to .env and adjust. Compose reads it automatically; every value has a default.

# Reranker device for the worker: cuda | cpu | auto (auto = cuda when a card is visible).
# This variable moves the WORKER only. The API service is pinned to cuda in the compose
# file and does not read it, so an 8 GB card holds ollama plus a cross-encoder in each of
# the two processes: the default pipeline reranks every answer and is meant to be resident.
WORKER_RERANK_DEVICE=cuda

# Queue lanes the worker serves, one thread each. Network and disk jobs live on io so they
# never wait behind GPU work.
WORKER_QUEUES=default,io

# Seconds the LLM client waits for one completion. Raise it for big models on CPU
# (a 70b answer takes minutes and dies at the default).
LLM_TIMEOUT=120

# Tokens for external MCP integrations; only names listed in config.yaml
# (mcp_integrations.secret_env) are ever read.
HF_TOKEN=
CONTEXT7_API_KEY=

# context window ollama loads models with; 4096 (its default) silently truncates agent hops
OLLAMA_CONTEXT_LENGTH=8192
