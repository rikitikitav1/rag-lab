# Copy to .env and adjust. Compose reads it automatically; every value has a default.

# The reranker is the `reranking` role on the `vllm-rerank` service: `docker compose --profile rerank up`.
VLLM_RERANK_GPU_UTIL=0.3

# The judge's share of the card; every sleeping vLLM beside it keeps about 200 MiB.
VLLM_GPU_UTIL=0.9

# vLLM on the processor, `--profile cpu`: it holds its whole model in host memory; `free` first.
VLLM_CPU_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_CPU_DTYPE=float16
VLLM_CPU_KVCACHE_SPACE=4

# The embedder on vLLM, `--profile embed`, and the keep-alive of the processor ollama.
VLLM_EMBED_GPU_UTIL=0.45
OLLAMA_CPU_KEEP_ALIVE=10m

# One <PREFIX>_BASE_URL per engine row, named by its env_prefix: VLLM_CPU_BASE_URL=http://vllm-cpu:8000

# Queue lanes the worker serves, one thread each. Network and disk jobs live on io.
WORKER_QUEUES=default,io

# Seconds the LLM client waits for one completion; a 70b answer on CPU dies at the default.
LLM_TIMEOUT=120

# Tokens for external MCP integrations, read only for names in config.yaml.
HF_TOKEN=
CONTEXT7_API_KEY=

# Context window ollama loads models with; 4096 silently truncates agent hops.
OLLAMA_CONTEXT_LENGTH=8192

# Rows in flight. Measured at 4 slots: 9 faithfulness scores of 50 turned over, 1.45x speed.
JUDGE_WIDTH=1

# Sequences the ollama server batches at once; JUDGE_WIDTH is capped by this.
OLLAMA_NUM_PARALLEL=1

# only for a script run on the host: inside compose the service names resolve and these stay unset
POSTGRES_HOST=
OLLAMA_BASE_URL=

# one pair per engine row named by its `env_prefix`; outside compose the host gateway resolves
VLLM_BASE_URL=
VLLM_API_KEY=
CLOUD_BASE_URL=
CLOUD_API_KEY=

# ragas posts a usage event per generation, synchronously, inside the measured window
RAGAS_DO_NOT_TRACK=true
