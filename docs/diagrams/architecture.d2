direction: right

client: Client {
  shape: person
}

lab: rag-lab (docker compose, runtime) {
  boot: "startup pipeline, runs to completion first:\ndbmate -> seed -> bootstrap\n(vLLM up and put to sleep first;\nthe API and the worker gate on it)" {
    style.stroke-dash: 3
  }

  api: FastAPI\n(uvicorn --reload) {
    rest: REST /v1/*
    mcp: MCP /mcp
    ops: MCP /mcp-ops
  }

  worker: Worker {
    default: lane "default"\n(GPU jobs)
    io: lane "io"\n(network jobs)
  }

  postgres: PostgreSQL\n+ pgvector {
    shape: cylinder
  }

  ollama: Ollama (GPU) {
    gen: llama3.1:8b
    embed: bge-m3
  }

  vllm: "vLLM (GPU),\nasleep unless it holds the card" {
    judge: Qwen2.5-7B-Instruct-AWQ
  }

  rerank: "vllm-rerank\n(profile rerank)" {
    style.stroke-dash: 3
    reranker: bge-reranker-v2-m3
  }
}

hub: "huggingface.co\n(vLLM weights)"

external: External MCP servers {
  deepwiki: DeepWiki
  hf: Hugging Face
  context7: Context7
}

client -> lab.api.rest: HTTP
client -> lab.api.mcp: MCP clients\n(Claude, Cursor)

lab.api -> lab.postgres: ORM (sync + async)
lab.api -> lab.postgres: enqueue jobs {style.stroke-dash: 3}
lab.worker -> lab.postgres: claim jobs\nFOR UPDATE SKIP LOCKED

lab.worker.default -> lab.ollama: generate / embed
lab.worker.default -> lab.vllm: judge
lab.worker.default -> lab.rerank: score pairs
lab.worker.default -> lab.vllm: "hand the card:\nsleep one engine, wake the other" {style.stroke-dash: 3}
lab.worker.io -> lab.ollama: model pull / delete\n(ollama downloads from hf.co / registry)
lab.worker.io -> hub: "vLLM weights into\nthe host's HF cache"
lab.api -> lab.ollama: chat, agent hops

lab.worker.io -> external: health jobs
lab.api -> external: discover / probe /\nagent tool calls (namespaced integration__tool) {
  style.stroke-width: 3
}
