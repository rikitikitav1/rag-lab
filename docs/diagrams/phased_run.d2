direction: down

title: |md
  ### Inside one eval run: phases, not a per-question loop
|

card: GPU (8 GB) {
  style.stroke-dash: 3
  style.fill: "#f6f8fa"

  p1: "PHASE 1 - retrieve" {
    style.fill: "#d4edda"
    embed: "one embeddings batch\nfor the whole set (bge-m3)"
    search: "hybrid search per question,\nwide pool when reranking"
    embed -> search
  }

  p2: "PHASE 2 - rerank" {
    style.fill: "#fff3cd"
    flat: "flatten to pairs:\n100 questions x 20 candidates = 2000"
    once: "one predict for all of them,\nfp16 on the card"
    back: "slice scores back per question,\nkeep top k"
    flat -> once -> back
  }

  p3: "PHASE 3 - generate" {
    style.fill: "#d4edda"
    gen: "answer from the context\nthat is already prepared\n(llama3.1:8b)"
    logrow: "question_log + config snapshot:\nrerank, device, k, phased"
    gen -> logrow
  }

  p1 -> p2: "ollama models unloaded\n(keep_alive 0)" {
    style.stroke-width: 2
  }
  p2 -> p3: "reranker unloaded,\ncuda cache emptied" {
    style.stroke-width: 2
  }
}

note: |md
  Two model swaps per run, not two per question.
|
