direction: down

title: "Inside one eval run: phases, not a per-\nquestion loop" {
  near: top-center
  style.stroke-width: 0
  style.fill: transparent
}

card: GPU (8 GB) {
  style.stroke-dash: 3
  style.fill: "#f6f8fa"

  p1: "PHASE 1 - retrieve" {
    style.fill: "#d4edda"
    embed: "one embeddings batch for the whole set\n(bge-m3)"
    search: "hybrid search per question, wide pool when\nreranking"
    embed -> search
  }

  p2: "PHASE 2 - rerank" {
    style.fill: "#fff3cd"
    flat: "flatten to pairs: 100 questions x 20\ncandidates = 2000"
    once: "one predict for all of them, fp16 on the card"
    back: "slice scores back per question, keep top k"
    flat -> once -> back
  }

  p3: "PHASE 3 - generate" {
    style.fill: "#d4edda"
    gen: "answer from the context that is already\nprepared (llama3.1:8b)"
    logrow: "question_log + config snapshot: rerank,\ndevice, k, phased"
    gen -> logrow
  }

  p1 -> p2: "ollama models unloaded (keep_alive 0)" {
    style.stroke-width: 2
  }
  p2 -> p3: "reranker unloaded, cuda cache emptied" {
    style.stroke-width: 2
  }
}

why: "Why phases: embedder, reranker and generator\ndo not fit in 8 GB together, so a per-\nquestion loop reloaded a model on every\nquestion. Phases give each stage the card\nalone: two swaps per run instead of two per\nquestion" {
  near: bottom-center
  style.stroke-dash: 3
}
live: "Interactive answers stay a straight line: one\nquestion cannot be batched, and the agent\ndecides for itself when to search" {
  near: bottom-right
  style.stroke-dash: 3
}
