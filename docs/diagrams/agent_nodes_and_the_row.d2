# hand-written, unlike agent_graph.d2. The middle block is a plan, not the code
direction: down

title: |md
  # What each node puts on the row
  The tool step is three nodes.\
  The coverage verdict rides an edge.\
  The rewrite is not built.
|

today: Today: six nodes {
  style.fill: "#eef1f8"
  model: "model\ncall the LLM with the tools this hop is allowed" {shape: hexagon}
  retrieve: "retrieve\nour dispatch; raw results to the state,\nno message for the model" {shape: hexagon}
  grade: "grade\nread each chunk, drop the foreign ones;\noff by default, then a pass-through" {shape: hexagon}
  fallback: "fallback\nthe verdict fired: drop weak,\nannounce, open external" {shape: hexagon}
  emit: "emit\ntool messages, after the verdict" {shape: hexagon}
  final: "final\nlast turn without tools" {shape: hexagon}
  model -> retrieve
  retrieve -> grade
  grade -> fallback: "verdict"
  grade -> emit: "covered"
  fallback -> emit
  emit -> model
  emit -> final
  model -> final
}

planned: Not built {
  style.fill: "#eceff4"
  style.stroke-dash: 3
  search: "search\ncorpus retrieval becomes a node,\nnot a tool the model calls" {shape: hexagon}
  enough: "enough kept?" {shape: diamond}
  rewrite: "rewrite_question\nask the corpus again in other words" {shape: hexagon}
  answer: "answer" {shape: hexagon}
  search -> enough
  enough -> answer: yes
  enough -> rewrite: no
  rewrite -> search
}

row: What the row carries {
  style.fill: "#fff3cd"
  here: "today: chunks[], spans[], transcript[],\nmetrics.announced_text, metrics.refusal,\nmetrics.asks with a verdict per chunk,\na prompt version per purpose"
  later: "only with the nodes above:\nmetrics.rewrite" {
    style.stroke-dash: 3
  }
}

families: What can be read, and what cannot {
  style.fill: "#e3e9fd"
  judged: "With the judge: A/B against single_shot,\njudge pinned, repeat arm taken"
  gold: "Without a judge: the grader against\nmarked_sources. Needs the nodes above" {
    style.stroke-dash: 3
  }
}

tracing: "Tracing reads these fields, it does not replace them.\nClosing condition: the outcome breakdown by hop and node\nis read from the record, not from a series of SQL queries." {
  style.fill: "#f7f8fe"
  style.stroke-dash: 3
}

today -> planned: "the corpus leg would stop being\na tool call, where the template limit bites"
# the verdict already rides an edge; the node that would read it is not built
planned -> row: "each would have written its decision"
row -> families: "and only then can these be read"
row -> tracing
