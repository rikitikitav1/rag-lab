direction: down

vary: What an arm can change {
  grid-columns: 5
  grid-gap: 24

  corpus: Corpus {
    grid-columns: 1
    grid-gap: 12
    axis: "variant: how it is cut\n(generation, retrieval)\nsource: what it holds\n(retrieval)"
  }

  search: Retrieval {
    grid-columns: 1
    grid-gap: 12
    axis: "k (generation)\nlimit_vector, limit_keyword,\nrerank_top, distance_threshold,\nef_search (retrieval)"
    run: "rerank on or off" {
      style.stroke-dash: 3
    }
  }

  path: Answering path {
    grid-columns: 1
    grid-gap: 12
    axis: "max_hops (generation)"
    run: "single_shot or agent,\nfallback_policy, gate_signal,\nweak_distance, topic_threshold,\norchestrator" {
      style.stroke-dash: 3
    }
  }

  model: Model@engine {
    grid-columns: 1
    grid-gap: 12
    axis: "model (generation): a row on\nollama, vLLM, the processor\nor a cloud broker"
    run: "generation_sampler" {
      style.stroke-dash: 3
    }
  }

  judge: Judge {
    grid-columns: 1
    grid-gap: 12
    axis: "judge model, prompt versions\n(rejudge: answers held)"
    run: "guest RAGAS pass" {
      style.stroke-dash: 3
    }
  }
}

runs: "One experiment: one axis swept" {
  grid-columns: 3
  grid-gap: 40

  bank: "One question set\nin corpus, out of corpus,\noff domain; more than\none language" {
    shape: cylinder
  }

  arms: Arms {
    grid-columns: 3
    grid-gap: 12
    a: arm A
    b: arm B
    a2: "arm A again" {
      style.stroke-dash: 3
    }
  }

  rows: "Rows per question\nanswer, outcome,\nthree judged axes,\nthe run's snapshot" {
    shape: page
  }

  bank -> arms
  arms -> rows
}

read: What you read {
  list: |md
    - paired deltas per pool: interval, Wilcoxon, Holm
    - against the floor: the same arm twice, a judge against its second pass
    - what else differed: engine, judge prompt, grammar, residency, penalty
    - cost: seconds and tokens
  | {
    shape: rectangle
  }
}

vary -> runs
runs -> read

legend: "solid: an experiment axis, its kind in brackets\ndashed: a setting of one run" {
  near: bottom-center
  style.stroke-dash: 3
}
