direction: down

entry: "" {
  grid-rows: 1
  grid-gap: 60
  style.stroke-width: 0
  style.fill: transparent

  ask: "Who asks for the card" {
    grid-columns: 3
    grid-gap: 24
    job: "a job,\nbefore its work"
    call: "a call of a role on another\nengine, mid-job: waits until\nthe old engine's calls end"
    door: "an API door: cannot wait,\nqueues a hand_card job for\nthe worker, answers 503 with\nRetry-After (/load answers 202)"
  }

  take: "take: the engine holds the card,\nthe model loaded and whole on it?" {
    shape: diamond
  }

  kept: "nothing to do"

  ask -> take
  take -> kept: yes
}

hand: "hand_to" {
  grid-columns: 1
  grid-gap: 40
  head: "" {
    grid-rows: 1
    grid-gap: 48
    style.stroke-width: 0
    style.fill: transparent
    off: "off the card\n(processor, cloud):\nload there, take nothing"
    oncard: "the target\non the card?" {shape: diamond}
    oncard -> off: no
  }

  chain: "" {
    grid-rows: 1
    grid-gap: 48
    style.stroke-width: 0
    style.fill: transparent
    silent: "the target down\nor silent?" {shape: diamond}
    release: "each other holder\nlets go: ollama unloads,\nvLLM sleeps"
    wake: "the target takes it:\nvLLM wakes,\nollama loads"
    whole: "the model whole\non the card?" {shape: diamond}
    others: "anyone else\nstill holding?" {shape: diamond}
    handed: "card.handed" {style.bold: true}

    silent -> release: no
    release -> wake
    wake -> whole
    whole -> others: yes
    others -> handed: no
  }

  stuck: "CardNotHanded: mode 7, the card is stuck\n(signs and fixes in stand_modes.md)" {
    style.stroke-dash: 3
  }

  head.oncard -> chain.silent: yes
  chain.silent -> stuck: "yes: the card\nstays where it is" {style.stroke-dash: 3}
  chain.release -> stuck: "not let go\nin 60 s" {style.stroke-dash: 3}
  chain.wake -> stuck: "not taken\nin 60 s" {style.stroke-dash: 3}
  chain.whole -> stuck: "no: half on\nthe processor" {style.stroke-dash: 3}
  chain.others -> stuck: yes {style.stroke-dash: 3}
}

entry -> hand: "take: no"
