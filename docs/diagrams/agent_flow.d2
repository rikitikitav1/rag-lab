direction: down

q: POST /v1/agent/question\nfallback_policy: corpus_first | corpus_first_weak | agent_choice
topic: "Topic axis, before any tool is offered\ndistance to the nearest chunk >= topic_threshold (0.50)\n= not our domain: no tools, context dropped, refuse" {
  style.fill: "#fff3cd"
}
toolbox: Build toolbox {
  static: search_corpus
  remote: remote tools from\nactive integrations\n(allowlist x schema cache)
  admit: "admissible? does the question itself carry\nthis tool's required arguments" {
    style.fill: "#fff3cd"
  }
  withheld: "corpus_first: admitted tools stay out of the schema\nuntil the corpus fails, dispatch refuses them by name" {
    style.fill: "#fff3cd"
  }
  remote -> admit -> withheld
}
hop1: "Hop 1: LLM sees search_corpus only" {
  shape: hexagon
}
nudge: "Narrated a call instead of issuing one?\nOne nudge per run, and never on the last hop\n(it must not buy an extra one)" {
  style.fill: "#fff3cd"
}
search: search_corpus
gate: "Coverage gate, once per turn\ncorpus_first: any rows above the distance threshold\ncorpus_first_weak, gate_signal:\ndistance (default): best hit's vector distance\n  <= weak_distance\ncross_encoder: best of the top 5 >= weak_threshold\neither: weak when one of the two says so" {
  style.fill: "#fff3cd"
}
answer_corpus: Answer from corpus\nsources = chunks {
  style.fill: "#d4edda"
}
open: "fallback_reason: empty | weak\nweak chunks dropped (kept in the log for hit@k),\nadmitted schemas join the toolbox,\nnotice appended to the tool result" {
  style.fill: "#fff3cd"
}
hop2: "Hop 2..max_hops: LLM decides,\nadmitted tools now visible" {
  shape: hexagon
}
remote_call: "deepwiki__ask_question" {
  shape: hexagon
}
remote_ok: Answer from remote\nsource = "mcp:deepwiki__ask_question" {
  style.fill: "#d4edda"
}
remote_err: "\"error: tool ... failed (<kind>)\"\nkind: timeout | connect | auth |\nclient | server | tool | empty" {
  style.fill: "#f8d7da"
}
cap: "Hops spent (max_hops, default 4)\nor a turn came back empty" {
  style.fill: "#fff3cd"
}
final: "Last turn, tools taken away.\nWith no sources it carries the\nagent.no_evidence prompt" {
  style.fill: "#fff3cd"
}
refuse: "Refusal in words\noutcome = refused" {
  style.fill: "#fff3cd"
}
unsupported: "Answered with nothing to stand on\noutcome = unsupported_answer" {
  style.fill: "#f8d7da"
}
log: "Log: sources, context, outcome, fallback_reason,\nfallback_opened, tool_errors, retrieval snapshot,\nstage timings, config (gate, topic, mcp, policy,\nmax_hops, context window, code version)" {
  shape: page
}
metrics: |md
  ## Per pool, never in one average
  - in-corpus: faithfulness, relevance,
    completeness, hit@k / MRR
  - from a tool: remote_grounding
    (grounded in what the tool said)
  - off-domain: off_domain_grounding,
    refusals, answers with no support
  - outcomes: answered / refused /
    unsupported / narrated / exhausted
| {
  shape: page
}

q -> topic
topic -> toolbox: within the domain
topic -> hop1: off topic, no tools admitted\nand the context will be dropped
toolbox -> hop1
toolbox -> hop2: "agent_choice: everything\nvisible from hop 1" {
  style.stroke-dash: 3
}
hop1 -> search: tool call
hop1 -> nudge: prose instead of a call
hop2 -> nudge: prose instead of a call
nudge -> hop2: "one retry, same budget" {
  style.stroke-dash: 3
}
search -> gate
gate -> answer_corpus: covered
gate -> open: empty or weak
open -> hop2
hop2 -> remote_call: ask outside
hop2 -> search: search again
hop2 -> cap: budget spent
hop1 -> cap: budget spent
cap -> final
remote_call -> remote_ok: ok (truncated to\nmax_result_chars)
remote_call -> remote_err: classified on the call path
remote_err -> hop2: LLM sees the error,\nretries or gives up
final -> refuse: no source answered
final -> unsupported: answered anyway
answer_corpus -> log
remote_ok -> log
refuse -> log
unsupported -> log
log -> metrics
