direction: down

q: POST /v1/agent/question\nfallback_policy: corpus_first | corpus_first_weak | agent_choice
topic: "Topic axis, before any tool is offered\ndistance to the nearest chunk >=\ntopic_threshold (0.50) = not our domain: no\ntools, context dropped, refuse" {
  style.fill: "#fff3cd"
}
toolbox: Build toolbox {
  static: search_corpus
  remote: remote tools from\nactive integrations\n(allowlist x schema cache)
  admit: "admissible? does the question itself carry\nthis tool's required arguments" {
    style.fill: "#fff3cd"
  }
  withheld: "corpus_first: admitted tools stay out of the\nschema until the corpus fails, dispatch\nrefuses them by name" {
    style.fill: "#fff3cd"
  }
  remote -> admit -> withheld
}
hop1: "Hop 1: LLM sees search_corpus only" {
  shape: hexagon
}
search: search_corpus
gate: "Coverage gate, once per turn\ncorpus_first: any rows above the\ndistance\nthreshold\ncorpus_first_weak, gate_signal:\ndistance (default): best hit's vector\ndistance <= weak_distance\ncross_encoder: best of the top 5 >=\nweak_threshold\neither: weak when one of the two says\nso" {
  style.fill: "#fff3cd"
}
answer_corpus: Answer from corpus\nsources = chunks {
  style.fill: "#d4edda"
}
open: "fallback_reason: empty | weak weak chunks\ndropped (kept in the log for hit@k), admitted\nschemas join the toolbox, notice appended to\nthe tool result" {
  style.fill: "#fff3cd"
}
hop2: "Hop 2: LLM decides, admitted tools now visible" {
  shape: hexagon
}
remote_call: "deepwiki__ask_question" {
  shape: hexagon
}
remote_ok: Answer from remote\nsource = "mcp:deepwiki__ask_question" {
  style.fill: "#d4edda"
}
remote_err: "\"error: tool ... failed (<kind>)\"\nkind: timeout | connect | auth |\nclient | server | tool | empty" {
  style.fill: "#f8d7da"
}
no_evidence: "No source answered: final turn without tools,\nagent.no_evidence prompt" {
  style.fill: "#fff3cd"
}
refuse: "Refusal in words outcome = refused" {
  style.fill: "#fff3cd"
}
log: "Log: sources, context, outcome,\nfallback_reason, fallback_opened, tool_errors,\nretrieval snapshot, config (gate, mcp +\nmcp_configured, policy, max_hops)" {
  shape: page
}
metrics: |md
  ## Measured per pool, not in one average
  - in-corpus: faithfulness / relevance / completeness, hit@k / MRR
  - answered from a tool: remote_grounding (grounded in what the tool said, not in truth)
  - off-domain: off_domain_grounding, refusals, answers with no support
  - outcome histogram: answered / refused / unsupported / narrated call / exhausted
| {
  shape: page
}

q -> topic
topic -> toolbox: within the domain
topic -> no_evidence: off topic
toolbox -> hop1
toolbox -> hop2: "agent_choice: everything visible from hop 1" {
  style.stroke-dash: 3
}
hop1 -> search: tool call
search -> gate
gate -> answer_corpus: covered
gate -> open: empty or weak
open -> hop2
hop2 -> remote_call: ask outside
hop2 -> no_evidence: nothing left to ask
remote_call -> remote_ok: ok (truncated to\nmax_result_chars)
remote_call -> remote_err: classified on the call path
remote_err -> hop2: LLM sees the error,\nretries or gives up
no_evidence -> refuse
answer_corpus -> log
remote_ok -> log
refuse -> log
log -> metrics
