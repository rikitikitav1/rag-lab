direction: down

trigger: "index_data job, one corpus variant\n(bootstrap only on an empty database)"

sources: Source registry (reader pattern) {
  direction: right
  notes: notes\nmarkdown, ru
  interview: Devinterview repos\n173 x README, en
  docs: primer / redis-doc / cheatsheets\nfrontmatter titles, junk rules
  hooks: "each source class: discover / read\ncategory_for / section_root_for / postprocess"
}

policy: "Variant policy from config.yaml\nchunker, max_chunk_size, ceiling_on, header_prefix,\nboilerplate, frontmatter, parser, levels" {
  shape: document
}

idem: "Idempotent per (source, variant):\ndelete its old chunks of THIS variant only"

cut: The cut {
  direction: down
  legacy: "legacy (baseline, frozen)\nsplit on the literal H2, then by size"
  marks: "MarkdownHeaderTextSplitter says which lines are headings\n(fences, tilde fences, indented headings)\noccurrences counted on the file"
  fallback: "fences do not balance ->\nread fence-blind, and log it" {
    style.stroke-dash: 3
  }
  rooted: "rooted: root from section_root_for + H2,\nceiling on the body, prefix repeated whole"
  structured: "structured: H2 -> H3 -> size,\nslivers merged into the neighbour beside them"
  marks -> fallback: when unbalanced
  marks -> rooted
  marks -> structured
}

record: "Each chunk carries what decided it:\nsection, prefix_len, cut_by"

cat: "path -> ltree category"
embed: Batch embed\nbge-m3 via /api/embed {
  shape: hexagon
}
insert: "Bulk insert data_chunks\n(variant, section, prefix_len, content_hash)" {
  shape: cylinder
}

idx: "build_vector_index job: partial hnsw\nper variant, built after the insert" {
  style.stroke-dash: 3
}
tsv: "FTS trigger: to_tsvector per language (rus/eng)" {
  style.stroke-dash: 3
}

quality: "analyze_source job, one per source:\ncoverage report from the text alone,\nhard and soft gates, score 0-100" {
  style.stroke-dash: 3
}

questions: embed_questions job\nquestion bank vectors {
  style.stroke-dash: 3
}

trigger -> sources
policy -> cut: decides every rule
sources -> idem -> cut -> record -> cat -> embed -> insert
insert -> tsv: on write
insert -> idx: queued, then built
insert -> quality: queued per source
trigger -> questions

note: |md
  The cut is a parameter, not a fact: variants
  live side by side, so re-indexing is a
  comparison rather than a border.

  What counts as a heading is the parser's
  answer; the text between them is sliced from
  the file, so nothing is rewritten on the way
  in.

  The preflight re-cuts every variant and
  compares the text of each chunk: a changed cut
  can keep its row count exactly.
|
