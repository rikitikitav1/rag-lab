direction: down

exp: POST /v1/experiment {
  shape: hexagon
}

runs: "eval_run jobs, one per swept value\n(k / max_hops / model / variant / agent policies)" {
  direction: right
  r1: run k=01
  r2: run k=05
  r3: run k=10
}

logs: question_logs\n(answer, context, sources) {
  shape: cylinder
}

judge: judge_answers job\nLLM judge, 0-10 per axis {
  axes: faithfulness / relevance / completeness
}

agg: Experiment aggregator {
  direction: right
  composite: RRF composite\n(generation axes only)
  pairwise: pairwise stats\nbootstrap CI + Wilcoxon\n+ Holm flags
}

results: results.composite\nwinner + significance {
  shape: page
}

exp -> runs: enqueue (find-or-create\nmissing models)
runs -> logs
logs -> judge
judge -> agg: live trigger on\nlast run judged
agg -> results

note: "hit@k and MRR stay out of the composite:\nhit@k grows with k and would confound it" {
  near: bottom-center
  style.stroke-dash: 3
}
